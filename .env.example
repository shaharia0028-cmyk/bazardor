# ── Data API ─────────────────────────────────────────────
BAZARDOR_API_URL=https://api.api-store.workers.dev/api/bazardor

# ── MongoDB (Atlas or local) ─────────────────────────────
MONGODB_URI=
MONGODB_DB=bazardor

# ── BetterAuth ───────────────────────────────────────────
# Generate a secret with: npx @better-auth/cli secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Local: http://localhost:3000   |   Production: your Vercel URL
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Google OAuth (console.cloud.google.com → Credentials) ─
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── GitHub OAuth (github.com/settings/developers) ────────
# Callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
